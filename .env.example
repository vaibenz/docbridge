# Gemini for embeddings, grading, rewriting and answers. Leave empty for the offline path.
GOOGLE_API_KEY=
# DOCBRIDGE_LLM_MODEL=gemini-3.8-flash

# Postgres with pgvector (docker compose up -d). Leave unset for the in memory store.
DOCBRIDGE_DATABASE_URL=postgresql://docbridge:docbridge@localhost:5432/docbridge

# Force a backend: DOCBRIDGE_EMBEDDER=hashing|gemini, DOCBRIDGE_LLM=offline|gemini
# DOCBRIDGE_EMBEDDER can also be wordllama (the offline default when installed)

# Service (uvicorn docbridge.api:app)
# DOCBRIDGE_AUTH=dev                      # local only: trust X-Dev-Groups, no sign in
DOCBRIDGE_OIDC_ISSUER=https://accounts.google.com
DOCBRIDGE_OIDC_AUDIENCE=your-client-id.apps.googleusercontent.com
DOCBRIDGE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
DOCBRIDGE_ACCESS_FILE=access.json         # emails and domains to groups, see access.example.json
# DOCBRIDGE_GROUPS_CLAIM=groups           # for providers that put groups in the token
# DOCBRIDGE_RATE_PER_MIN=30
# DOCBRIDGE_ALLOWED_LINK_DOMAINS=harbourline.example
